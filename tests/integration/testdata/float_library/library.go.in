package probe

import "github.com/eugenioenko/goalchemy/lib/context"

type F32 float32

type Value struct {
	Small  F32
	Wide   float64
	Values []float32
	Nested [][]float64
	Pair   [2]float32
}

var fixed = [2]float32{1.5, -2.25}

func Scalar32(ctx context.Context, v F32) (F32, error)         { return v, nil }
func Scalar64(ctx context.Context, v float64) (float64, error) { return v, nil }

func Both(ctx context.Context, small float32, wide float64) (float32, float64, error) {
	return small, wide, nil
}

func Echo(ctx context.Context, v Value) (Value, error) {
	if len(v.Values) > 0 {
		v.Values[0] += 1
	}
	if len(v.Nested) > 0 && len(v.Nested[0]) > 0 {
		v.Nested[0][0] += 2
	}
	return v, nil
}

func Suspended(ctx context.Context, v Value) (Value, error) {
	ch := make(chan Value)
	go func() { ch <- v }()
	return <-ch, nil
}

func Fixed(ctx context.Context) (Value, error) {
	return Value{Values: fixed[:], Nested: [][]float64{{3.5}}, Pair: fixed}, nil
}
