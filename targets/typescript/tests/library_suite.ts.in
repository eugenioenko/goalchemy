// Independent native consumer of actual compiler exports and declarations.
import * as g from './main.js';
import { NativeKey } from './rt/types/crypto.js';
import { sched } from './rt/runtime/task_spawn.js';
function assert(ok:unknown,message:string):asserts ok{if(!ok)throw new Error(message);}
function same(b:Uint8Array|null,expected:number[]):boolean{return b!==null&&b.length===expected.length&&expected.every((n,i)=>b[i]===n);}
function gate(){let resolve!:()=>void;const promise=new Promise<void>(r=>resolve=r);return {promise,resolve};}
async function reject(work:Promise<unknown>,kind:string):Promise<g.LibraryError>{try{await work;}catch(e){assert(e instanceof g.LibraryError,'typed failure');assert(e.kind===kind,'expected '+kind+', got '+e.kind);return e;}throw new Error('expected '+kind);}
export async function runLibrarySuite(url?:string,factories:((values:number[])=>Uint8Array)[]=[]):Promise<void>{
 class BorrowingBytes extends Uint8Array<ArrayBuffer>{constructor(values:number[]){super(new Uint8Array(values).buffer);}override slice(start=0,end=this.length){return this.subarray(start,end);}}
 for(const make of [((values:number[])=>new BorrowingBytes(values)),...factories]){
  const started=gate(),release=gate();const hold=g.Provider('queue',null,{callbacks:{queue:async()=>{started.resolve();await release.promise;return null;}}});await started.promise;
  const payload=make([0,255]),metadata=make([128,7]),nested=make([9]),outer=[nested],names=['saved'];for(const array of [outer,names]){Object.defineProperty(array,'map',{value:()=>array});Object.defineProperty(array,Symbol.iterator,{value:()=>{throw new Error('caller iterator invoked');}});}const queued=g.Echo({Data:payload,Empty:metadata,Nested:outer,Names:names});payload.fill(44);metadata.fill(44);nested.fill(44);names[0]='changed';outer[0]=make([1]);release.resolve();await hold;const copied=await queued;assert(same(copied.Data!,[1,255])&&same(copied.Empty!,[128,7])&&same(copied.Nested![0]!,[9])&&copied.Names![0]==='saved','queue input copy ignores borrowed slice/map/iterator overrides');
  const reply=make([255,128]);const published=await g.Provider('copy',null,{callbacks:{copy:(_signal,_input,settle)=>{settle(reply);reply.fill(44);settle(make([1]));}}});assert(same(published,[255,128]),'publication copy ignores borrowed slice override');
  const promised=make([128,255]);const owned=await g.Provider('promise',null,{callbacks:{promise:async()=>promised}});promised.fill(44);assert(same(owned,[128,255]),'observed Promise reply copy ignores borrowed slice override');
 }
 const input={Data:new Uint8Array([0,255]),Nested:[new Uint8Array([9])],Empty:new Uint8Array(),Count:9223372036854775807n};
 const first=await g.Echo(input);assert(first.Count===6n&&same(first.Data!,[1,255])&&input.Data[0]===0,'snapshot/init');const second=await g.Echo({});assert(second.Count===6n&&second.Data===null&&first.Empty?.length===0,'fresh init/nil/empty');first.Nested![0]![0]=1;assert(input.Nested[0][0]===9,'nested ownership');
 const retained=await g.Fixed();assert(same(retained,[0,255,128]),'fixed global slice ownership');const failure=await reject(g.ErrorGlobal(),'source');assert(failure.fields.Code==='saved'&&(failure.fields.Obligations as string[])[0]==='obligation','global error ownership');await Promise.all(Array.from({length:12},()=>g.Fixed().then(b=>assert(same(b,[0,255,128]),'concurrent globals'))));assert(same(retained,[0,255,128])&&failure.fields.Code==='saved','retained result/error after calls');
 let late:g.Settlement|undefined;const published=new Uint8Array([255,0]);const explicit=await g.Provider('explicit',null,{callbacks:{explicit:(_signal,_request,settle)=>{late=settle;settle(published);published[0]=0;settle(new Uint8Array([1]));}}});assert(same(explicit,[255,0]),'synchronous snapshot and duplicate settlement');late!(new Uint8Array([1]));await g.Echo({});assert(same(explicit,[255,0]),'late publication cannot revive owner');
 let callbackInput:Uint8Array|null=null;const reply=new Uint8Array([255,0]);const provider=await g.Provider('token',new Uint8Array([0,255]),{callbacks:{token:async(_signal,b)=>{callbackInput=b;return reply;}}});reply[0]=0;assert(same(provider,[255,0])&&same(callbackInput,[0,255]),'copied provider bytes');await reject(g.Provider('token',null),'source');await reject(g.Provider('token',null,{callbacks:{token:async()=>{throw new Error('reject');}}}),'source');await reject(g.SourcePanic(),'source_panic');
 assert(same(await g.KeySuccess(),[7]),'successful native deferred Close');assert(same(await g.GoClose(),[8]),'successful native go Close');
 const keys:NativeKey[]=[];const origClose=NativeKey.prototype.close;NativeKey.prototype.close=function(){if(!keys.includes(this))keys.push(this);return origClose.call(this);};
 try{await reject(g.KeyProvider('fault',{callbacks:{fault:()=>{throw new Error('secret host fault');}}}),'host_fault');assert(keys.length>0&&keys.every(k=>!k.state().retained),'key cleanup after host fault');}finally{NativeKey.prototype.close=origClose;}
 const hookStarted=gate(),hookStopped=gate();let hookSettle:g.Settlement|undefined;const hookCancel=new AbortController();let hookDone=false;const hookFailure=g.Provider('stop',null,{signal:hookCancel.signal,callbacks:{stop:(_signal,_request,settle)=>{hookSettle=settle;hookStarted.resolve();return ()=>{hookStopped.resolve();throw new Error('stop fault');};}}}).finally(()=>hookDone=true);await hookStarted.promise;hookCancel.abort();await hookStopped.promise;await Promise.resolve();assert(!hookDone,'stop fault does not fabricate ACK');hookSettle!(null,new Error('retired'));await reject(hookFailure,'host_fault');
 const started=gate(),resource=gate(),aborted=gate();let settled=false;const active=new AbortController();
 const pending=g.Provider('wait',new Uint8Array([7]),{signal:active.signal,callbacks:{wait:async signal=>{started.resolve();signal.addEventListener('abort',()=>aborted.resolve(),{once:true});await resource.promise;return new Uint8Array([1]);}}}).finally(()=>settled=true);
 await started.promise;const queued=new AbortController(),q=g.Echo({Data:new Uint8Array([1])},{signal:queued.signal});queued.abort('queued');await reject(q,'canceled');assert(!settled,'queued cancellation isolated');active.abort('active');await aborted.promise;await Promise.resolve();assert(!settled,'no fabricated provider cleanup ACK');resource.resolve();await reject(pending,'canceled');await g.Echo({});
 // Hold the result of actual maintained native signing, never replace crypto.
 const originalCrypto=globalThis.crypto,signStarted=gate(),signRelease=gate(),closeStarted=gate();let raced=false;
 const proxy=new Proxy(originalCrypto.subtle,{get(target,name){if(name==='sign')return async(...args:Parameters<SubtleCrypto['sign']>)=>{const out=await target.sign(...args);if(!raced){raced=true;signStarted.resolve();await signRelease.promise;}return out;};const value=Reflect.get(target,name);return typeof value==='function'?value.bind(target):value;}});
 Object.defineProperty(globalThis,'crypto',{configurable:true,value:{subtle:proxy,getRandomValues:originalCrypto.getRandomValues.bind(originalCrypto)}});
 let closedBeforeRelease=false;NativeKey.prototype.close=function(){if(this.state().leases>0){closedBeforeRelease=true;closeStarted.resolve();}return origClose.call(this);};
 try{let complete=false;const racing=g.KeyRace({callbacks:{ready:async()=>{await signStarted.promise;return null;}}}).finally(()=>complete=true);await closeStarted.promise;await Promise.resolve();assert(!complete&&closedBeforeRelease,'generated Close parked while actual native sign owns lease');signRelease.resolve();assert(same(await racing,[1,2,255]),'generated alias invalidation and retained sign');}finally{signRelease.resolve();NativeKey.prototype.close=origClose;Object.defineProperty(globalThis,'crypto',{configurable:true,value:originalCrypto});}
 // Source panic during an actual native acquisition must wait for its result,
 // then discard/close the acquired output before ACK and owner release.
 const generated=gate(),generationRelease=gate();let acquired:NativeKey|null=null;
 const proxyGenerate=new Proxy(originalCrypto.subtle,{get(target,name){if(name==='generateKey')return async(...args:any[])=>{const out=await (target.generateKey as any)(...args);generated.resolve();await generationRelease.promise;return out;};const value=Reflect.get(target,name);return typeof value==='function'?value.bind(target):value;}});
 Object.defineProperty(globalThis,'crypto',{configurable:true,value:{subtle:proxyGenerate,getRandomValues:originalCrypto.getRandomValues.bind(originalCrypto)}});
 NativeKey.prototype.close=function(){acquired=this;return origClose.call(this);};
 try{let done=false;const acquisition=g.AcquirePanic().finally(()=>done=true);await generated.promise;await new Promise(r=>setTimeout(r,10));assert(!done,'panic waits actual native acquisition cleanup');generationRelease.resolve();await reject(acquisition,'source_panic');assert(acquired!==null&&!(acquired as NativeKey).state().retained,'late native acquisition released before ACK');}finally{generationRelease.resolve();NativeKey.prototype.close=origClose;Object.defineProperty(globalThis,'crypto',{configurable:true,value:originalCrypto});}
 const nativeFetch=globalThis.fetch;let contacts=0;globalThis.fetch=(...args)=>{contacts++;return nativeFetch(...args);};
 try{
  const target=url??'http://127.0.0.1:9/no-contact';
  for(const [name,value]of [['Accept-Charset','utf-8'],['Accept-Encoding','gzip'],['Access-Control-Request-Headers','x'],['Access-Control-Request-Method','POST'],['Connection','close'],['Content-Length','0'],['Cookie','x'],['Cookie2','x'],['Date','x'],['DNT','1'],['Expect','x'],['Host','x'],['Keep-Alive','x'],['Origin','x'],['Referer','x'],['Set-Cookie','x'],['TE','x'],['Trailer','x'],['Transfer-Encoding','x'],['Upgrade','x'],['Via','x'],['Proxy-X','x'],['Sec-X','x'],['X-HTTP-Method','TRACE'],['X-HTTP-Method-Override','GET, CONNECT'],['X-Method-Override','track']])await reject(g.FetchHeaders(target,[name,value]),'source');
  for(const value of ['\xef\xbb\xbf'+target,target+'#',target+'\\x',target+'/../changed',target+'/%2e%2e/changed',target+'?bad=%',target+'?bad=\n',target+'?bad=\xc3('])await reject(g.FetchHeaders(value,[]),'source');
  assert(contacts===0,'all invalid headers and ambiguous/malformed UTF8 URLs rejected before contact');
  if(url){await reject(g.Fetch(url.replace('/fetch','/truncated')),'source');assert(same(await g.Fetch(url),[0,255,128]),'actual native fetch parked source');const text=url.replace('/fetch','/日本語')+'?q=café';const raw=Array.from(new TextEncoder().encode(text),v=>String.fromCharCode(v)).join('');const headers=['Authorization','Bearer fixture','DPoP','fixture-proof','Content-Type','application/json','Connect-Protocol-Version','1','X-Copy',' \ttrimmed\t ','X-Method-Override','GET'];assert(same(await g.FetchHeaders(raw,headers),[0,255,128]),'UTF8 URL and allowed native headers including normalization');}
 }finally{globalThis.fetch=nativeFetch;}
 // A failed native stream can reject cancel with its already classified read
 // failure. A distinct cleanup fault still fails the host and delays true ACK.
 for(const distinct of [false,true]){
  const failure=new TypeError('read transport failure'),started=gate(),release=gate();let unlocked=false,done=false;
  globalThis.fetch=async()=>({type:'basic',status:200,headers:new Headers(),body:{getReader:()=>({read:async()=>{throw failure;},cancel:async()=>{started.resolve();await release.promise;throw distinct?new TypeError('unexpected cleanup failure'):failure;},releaseLock:()=>{unlocked=true;}})}} as unknown as Response);
  try{const pending=g.Fetch(url??'http://127.0.0.1:9/fault').finally(()=>done=true);await started.promise;await Promise.resolve();assert(!done&&!unlocked,'stream cleanup must really settle before ACK');release.resolve();await reject(pending,distinct?'host_fault':'source');assert(unlocked,'reader lock released before completion');await g.Echo({});}
  finally{release.resolve();globalThis.fetch=nativeFetch;}
 }
 console.log('PASS HTTP actual truncation/same-error cleanup/independent cleanup fault/true ACK');
 assert(sched.operations.size===0&&sched.tasks.size===0&&sched.disposers.size===0,'owner roots retired');console.log('PASS actual generated exports/declarations/init/bytes/global results/errors/providers/cancel/ACK/native key race/acquisition fault');
}
