  Raw(byte[] reply,long delay)throws IOException{worker=Thread.ofVirtual().start(()->{try(var client=socket.accept()){contacts.incrementAndGet();client.setSoTimeout(5000);InputStream in=client.getInputStream();int state=0;while(state<4){int b=in.read();if(b<0)return;state=b==new int[]{13,10,13,10}[state]?state+1:(b==13?1:0);}if(delay>0)Thread.sleep(delay);client.getOutputStream().write(reply);client.getOutputStream().flush();}catch(Exception expected){}});}
  String url(){return "http://127.0.0.1:"+socket.getLocalPort()+"/";}
  public void close()throws Exception{socket.close();worker.join(6000);check(!worker.isAlive(),"native fixture settlement");}
 }
